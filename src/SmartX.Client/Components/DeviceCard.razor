@* One device on the live dashboard: status, latest reading and (for switchable
   devices) ON/OFF override buttons. The parent sends the command. *@

<div class="device-card status-@Device.Status.ToString().ToLowerInvariant()">
    <div class="device-top">
        <span class="sx-dot sx-dot-@Device.Status.ToString().ToLowerInvariant()" title="@Device.Status"></span>
        <strong class="device-name">@Device.Name</strong>
        <span class="sx-pill sx-pill-sim" title="Generated by the API's device simulator">Sim</span>
    </div>

    <div class="device-meta mono">@Device.MacAddress &middot; @Device.ZoneName</div>
    <div class="device-meta">@Device.Kind &middot; @Device.Category</div>

    <div class="device-reading">
        @if (Device.LastReading is { } value)
        {
            <span class="reading-value mono">@FormatReading(value)</span>
            <span class="reading-type">@Device.SensorType</span>
        }
        else
        {
            <span class="muted small">No reading yet</span>
        }
    </div>

    <div class="device-status-row">
        <span class="sx-pill sx-pill-@Device.Status.ToString().ToLowerInvariant()">@Device.Status</span>
        @foreach (var errorCode in Device.ActiveErrorCodes)
        {
            <span class="sx-pill sx-pill-critical">@errorCode</span>
        }
        <span class="seen small muted">@LastSeenText</span>
    </div>

    @if (Device.IsControllable)
    {
        <div class="device-controls">
            <span class="power power-@(Device.IsOn ? "on" : "off")">@(Device.IsOn ? "ON" : "OFF")</span>
            <button class="sx-btn sx-btn-small" disabled="@(Busy || Device.IsOn)" @onclick="() => OnCommand.InvokeAsync((Device, CommandAction.TurnOn))">Turn on</button>
            <button class="sx-btn sx-btn-small" disabled="@(Busy || !Device.IsOn)" @onclick="() => OnCommand.InvokeAsync((Device, CommandAction.TurnOff))">Turn off</button>
        </div>
    }
</div>

<style>
    .device-card { background: var(--sx-surface); border: 1px solid var(--sx-border); border-radius: var(--sx-radius); padding: 0.85rem 0.95rem; display: flex; flex-direction: column; gap: 0.35rem; transition: border-color 0.3s ease, box-shadow 0.3s ease; }
    .device-card.status-fault { border-color: rgba(255, 176, 32, 0.5); box-shadow: 0 0 14px rgba(255, 176, 32, 0.12); }
    .device-card.status-disconnected { border-color: rgba(255, 59, 96, 0.45); opacity: 0.75; }
    .device-top { display: flex; align-items: center; gap: 0.5rem; }
    .device-name { font-size: 1rem; }
    .device-top .sx-pill { margin-left: auto; }
    .device-meta { font-size: 0.75rem; color: var(--sx-text-dim); }
    .device-reading { display: flex; align-items: baseline; gap: 0.5rem; margin: 0.25rem 0; }
    .reading-value { font-size: 1.35rem; color: var(--sx-cyan); }
    .reading-type { font-size: 0.75rem; color: var(--sx-text-faint); }
    .device-status-row { display: flex; gap: 0.35rem; align-items: center; flex-wrap: wrap; }
    .device-status-row .seen { margin-left: auto; }
    .device-controls { display: flex; gap: 0.4rem; align-items: center; margin-top: 0.35rem; padding-top: 0.5rem; border-top: 1px solid rgba(255,255,255,0.05); }
    .power { font-family: var(--sx-font-mono); font-weight: 700; font-size: 0.8rem; min-width: 2.4rem; }
    .power-on { color: var(--sx-green); }
    .power-off { color: var(--sx-text-faint); }
</style>

@code {
    [Parameter, EditorRequired] public DeviceDto Device { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<(DeviceDto Device, CommandAction Action)> OnCommand { get; set; }

    private string FormatReading(double value) => Device.Kind switch
    {
        DeviceKind.Relay => value >= 0.5 ? "CLOSED" : "OPEN",
        _ => $"{value:0.#} {Device.Unit}".TrimEnd()
    };

    private string LastSeenText => Device.LastSeenUtc is { } seen
        ? $"seen {Math.Max(0, (DateTimeOffset.UtcNow - seen).TotalSeconds):0}s ago"
        : "never seen";
}
