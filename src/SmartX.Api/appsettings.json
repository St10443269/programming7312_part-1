{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RealTime": {
    "Thresholds": {
      "MoistureCriticalPct": 20,
      "MoistureWarningPct": 30,
      "PowerSpikeWatts": 1500,
      "PowerWarningWatts": 1000,
      "TemperatureCriticalC": 40,
      "TemperatureWarningC": 35,
      "DisconnectAfterSeconds": 8
    },
    "Processing": {
      "IntervalMilliseconds": 300,
      "BatchSize": 50,
      "MaxConsecutivePriority": 5,
      "MaxHistoryEntries": 5000
    },
    "Simulator": {
      "StartOnLaunch": true,
      "TickMilliseconds": 1000,
      "RandomDisconnectChance": 0.002
    },
    "Recommendations": {
      "PatternWindowMinutes": 5,
      "MinPatternOccurrences": 2,
      "MinPatternConfidence": 0.5,
      "MinHistoryForPatterns": 3,
      "RecurringFaultThreshold": 3,
      "LookbackMinutes": 60
    }
  }
}
